{
  "name": "controle-de-ponto",
  "private": true,
  "version": "1.2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    },
    "brace-expansion@^1.1.7": "1.1.21"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
